{
  "name": "luv3",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "knip": "knip",
    "type-check": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "test:e2e": "playwright test",
    "backup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/backup/backup.mts",
    "backup:restore": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/backup/restore.mts",
    "admdong:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/admdong/build.mts",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "browser-image-compression": "2.0.2",
    "embla-carousel-react": "^8.6.0",
    "exifr": "7.1.3",
    "heic2any": "0.0.4",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "3.6.4",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "knip": "6.43.0",
    "smol-toml": "^1.9.1",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.15.0"
}

# 로컬: `pnpm db:start` 출력의 API URL과 Publishable key
# 운영: Supabase 대시보드 > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Vercel Cron이 /api/keepalive를 부를 때 붙이는 비밀 값(무작위 32자 이상). 없으면 이 경로는 모든 요청을 401로 막는다
# 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# 기록 폼의 장소 찾기(선택). 없으면 돋보기가 나오지 않고 이름만 적는다. 서버에서만 쓰므로 NEXT_PUBLIC_을 붙이지 않는다
# 카카오 개발자 콘솔 > 앱 > 플랫폼 키의 REST API 키([카카오맵] > [사용 설정]을 켠 앱)
KAKAO_REST_API_KEY=

# 기록 지도(선택). 없으면 기록 탭에 지도 버튼이 나오지 않는다. 브라우저에 보이는 값이라 카카오 콘솔에서 도메인을 제한한다
# 카카오 개발자 콘솔 > 앱 > 플랫폼 키의 JavaScript 키(SDK 도메인에 운영 주소와 http://localhost:3000 등록)
NEXT_PUBLIC_KAKAO_MAP_KEY=

# 캘린더·날짜 창의 공휴일(선택). 없으면 주말 색만 나온다. 서버에서만 쓰므로 NEXT_PUBLIC_을 붙이지 않는다
# 공공데이터포털 > "한국천문연구원_특일 정보" 활용신청 > 마이페이지 > 개발계정의 일반 인증키(Encoding·Decoding 어느 쪽이든)
HOLIDAY_API_KEY=
